<?xml version="1.0"?>
<package>
  <name>led_emitter</name>
  <version>1.0.0</version>
  <description>
    Controlador de LEDs para Duckiebot DB21J.
    Gestiona los patrones de iluminación frontal del robot
    basado en instrucciones del mission_controller.
  </description>

  <maintainer email="equipo@duocuc.cl">Equipo Duckie Day 2026</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>duckietown_msgs</build_depend>

  <run_depend>rospy</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>duckietown_msgs</run_depend>
  <run_depend>message_runtime</run_depend>

</package>
