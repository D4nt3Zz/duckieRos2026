<?xml version="1.0"?>
<package>
  <name>lane_follow</name>
  <version>1.0.0</version>
  <description>
    Nodo de seguimiento de carril para Duckiebot DB21J.
    Procesa imágenes de cámara para detectar carriles y publica
    comandos de movimiento para mantener el robot en el carril.
  </description>

  <maintainer email="equipo@duocuc.cl">Equipo Duckie Day 2026</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>duckietown_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>image_transport</build_depend>

  <run_depend>rospy</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>duckietown_msgs</run_depend>
  <run_depend>cv_bridge</run_depend>
  <run_depend>image_transport</run_depend>
  <run_depend>message_runtime</run_depend>

</package>
